{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@rakazo/ui-web/components",
    "utils": "@rakazo/ui-web/lib/utils",
    "ui": "@rakazo/ui-web/components/ui",
    "lib": "@rakazo/ui-web/lib",
    "hooks": "@rakazo/ui-web/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@uiarc": "https://uiarc.dev/r/{name}.json",
    "@uiarc-pro": {
      "url": "https://uiarc.dev/r/pro/{name}.json",
      "headers": {
        "Authorization": "Bearer ${ARC_PRO_TOKEN}"
      }
    },
    "@cult-ui-pro": {
      "url": "https://pro.cult-ui.com/api/registry/{name}",
      "headers": {
        "X-API-Key": "${CULT_PRO_API_KEY}"
      }
    },
    "@aisdkagents": {
      "url": "https://www.aisdkagents.com/pro-registry/{name}",
      "headers": {
        "Authorization": "Bearer ${AISDK_AGENTS_TOKEN}"
      }
    }
  }
}
